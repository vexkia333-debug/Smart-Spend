{
  "name": "finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"node --watch --experimental-sqlite server/index.js\" \"vite\"",
    "start": "node --experimental-sqlite server/index.js",
    "server": "node --watch --experimental-sqlite server/index.js",
